[Unit]
Description=Overpass replication lag monitor (OneUptime)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ overpass_repo_root }}
EnvironmentFile={{ monitoring_env_path }}
ExecStart={{ overpass_repo_root }}/scripts/monitor_replication.sh
DynamicUser=yes

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
