# Production profile: Germany, meta data (user/changeset), no attic, minutely updates.
# Extract and diffs come from the same osm-fr pipeline, so replicate_id matches and no OAuth is needed.
OVERPASS_DATA_ROOT=/srv/overpass
OVERPASS_IMPORT_URL=https://download.openstreetmap.fr/extracts/europe/germany-latest.osm.pbf
OVERPASS_DIFF_URL=https://download.openstreetmap.fr/replication/europe/germany/minute/
OVERPASS_META_MODE=yes
OVERPASS_AREAS=yes
OVERPASS_BACKUP_TIME=03:30
NGINX_CLIENT_REQ_RATE=2r/s
OVERPASS_CPUS=4
OVERPASS_MEMORY=8g
OVERPASS_DOMAIN=private-overpass.fixmycity.de
TRAEFIK_ACME_EMAIL=dev-team@fixmycity.de
# Updates, downloads and backups pause below this share of free disk (protects co-hosted services).
OVERPASS_MIN_FREE_DISK_PERCENT=20
