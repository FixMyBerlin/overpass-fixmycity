# Local test profile: Monaco (~1 MB) through the same osm-fr extract + minute diff pipeline as production.
# Set OVERPASS_DATA_ROOT outside the repo when running, e.g. OVERPASS_DATA_ROOT=$TMPDIR/overpass-test.
OVERPASS_DATA_ROOT=./.local/overpass-test
OVERPASS_IMPORT_URL=https://download.openstreetmap.fr/extracts/europe/monaco-latest.osm.pbf
OVERPASS_DIFF_URL=https://download.openstreetmap.fr/replication/europe/monaco/minute/
OVERPASS_META_MODE=yes
OVERPASS_AREAS=no
OVERPASS_CPUS=1
OVERPASS_MEMORY=1g
