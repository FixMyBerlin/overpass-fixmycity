# Host paths (local cache and persistent DB)
OVERPASS_DATA_ROOT=./.local/overpass-data
TRAEFIK_ACME_ROOT=./.local/traefik

# Overpass behavior
OVERPASS_META=yes
OVERPASS_MODE=init
OVERPASS_STOP_AFTER_INIT=false
OVERPASS_RATE_LIMIT=2
OVERPASS_DIFF_URL=https://download.geofabrik.de/europe/germany-updates/
OVERPASS_ALLOW_DUPLICATE_QUERIES=yes
OVERPASS_UPDATE_SLEEP=3600
OVERPASS_COMPRESSION=gz
OVERPASS_RULES_LOAD=10

# Import source and auth (container-native download path)
OVERPASS_PLANET_URL=https://osm-internal.download.geofabrik.de/europe/germany-latest-internal.osm.pbf
OVERPASS_PLANET_PREPROCESS=mv /db/planet.osm.bz2 /db/planet.osm.pbf && osmium cat -o /db/planet.osm.bz2 /db/planet.osm.pbf && rm /db/planet.osm.pbf
USE_OAUTH_COOKIE_CLIENT=yes
OVERPASS_OAUTH_USER=dev-team@fixmycity.de
OVERPASS_OAUTH_PASSWORD=
OVERPASS_OAUTH_OSM_HOST=https://www.openstreetmap.org
OVERPASS_OAUTH_CONSUMER_URL=https://osm-internal.download.geofabrik.de/get_cookie
OVERPASS_COOKIE_JAR_CONTENTS=

# Public HTTPS routing (Traefik)
OVERPASS_DOMAIN=overpass.fixmycity.de
OVERPASS_ALLOWED_CIDRS=127.0.0.1/32
TRAEFIK_ACME_EMAIL=dev-team@fixmycity.de
TRAEFIK_LOG_LEVEL=WARN
TRAEFIK_API_INSECURE=false
TRAEFIK_DASHBOARD=false
TRAEFIK_READ_TIMEOUT=300s
TRAEFIK_WRITE_TIMEOUT=300s
TRAEFIK_DIAL_TIMEOUT=100s

# Scripts/tests target URL for API checks
# Example for Traefik deployments: https://overpass.fixmycity.de
OVERPASS_BASE_URL=http://127.0.0.1:8080

# Runtime test controls
OVERPASS_CONTAINER_NAME=overpass_de
OVERPASS_REPLICATION_WAIT_MS=65000
