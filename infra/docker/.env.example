# Host paths (local cache and persistent DB)
OVERPASS_DATA_ROOT=./.local/overpass-data
OVERPASS_CACHE_ROOT=./.local/cache
TRAEFIK_ACME_ROOT=./.local/traefik

# Overpass behavior
OVERPASS_META=no
OVERPASS_MODE=init
OVERPASS_STOP_AFTER_INIT=false
OVERPASS_DIFF_URL=https://planet.openstreetmap.org/replication/minute/
OVERPASS_ALLOW_DUPLICATE_QUERIES=yes

# Import source (set by scripts/ops/download_extract.ts)
OVERPASS_PLANET_URL=

# Public HTTPS routing (Traefik)
OVERPASS_DOMAIN=overpass.example.org
OVERPASS_ALLOWED_CIDRS=127.0.0.1/32
TRAEFIK_ACME_EMAIL=ops@example.org
TRAEFIK_LOG_LEVEL=WARN
TRAEFIK_API_INSECURE=false
TRAEFIK_DASHBOARD=false
TRAEFIK_READ_TIMEOUT=300s
TRAEFIK_WRITE_TIMEOUT=300s
TRAEFIK_DIAL_TIMEOUT=100s

# Optional local override for scripts/tests (defaults to http://127.0.0.1:8080)
# Example for Traefik deployments:
# OVERPASS_BASE_URL=https://overpass.example.org
OVERPASS_BASE_URL=
